# Copy this file to .env and fill in real values locally.
# .env is already gitignored — never commit real credentials (Constitution V, FR-021).

# Embeddings — Cluster + Filter Tier 2 (research.md §4, §5, contracts/external-integrations.md
# § Embeddings). Selects which embedding backend src/pipeline/embedding_provider.py resolves to:
#   ollama (default) — local, free, via a locally running Ollama server. No API key needed;
#     see the README "Setup" section for the `ollama pull nomic-embed-text` step.
#   voyage — hosted (voyage-4-lite), for users without a local Ollama install. Requires
#     VOYAGE_API_KEY below.
# Leave unset to use the default (ollama).
EMBEDDING_PROVIDER=
# Voyage AI API key — required only when EMBEDDING_PROVIDER=voyage. Ignored otherwise.
VOYAGE_API_KEY=

# X data read provider — selects which fetch backend src/pipeline/fetch_provider.py
# resolves to for src/pipeline/orchestrator.py's live Fetch stage:
#   twitterapis_com (default) — no fixed QPS cap, confirmed full data parity with
#     TwitterAPI.io via a live side-by-side comparison (2026-07-31). Requires
#     TWITTERAPIS_COM_KEY below.
#   twitterapi_io — the original provider, research.md §6. Paced to its 0.2 QPS
#     free tier. Requires TWITTERAPI_IO_KEY below.
# Leave unset to use the default (twitterapis_com).
FETCH_PROVIDER=

# TwitterAPIs.com API key — required only when FETCH_PROVIDER=twitterapis_com
# (the default). Ignored otherwise.
TWITTERAPIS_COM_KEY=
# TwitterAPI.io — required only when FETCH_PROVIDER=twitterapi_io. Ignored otherwise.
TWITTERAPI_IO_KEY=

# Anthropic Claude API — Summarize / Draft Post stages only (research.md §3)
ANTHROPIC_API_KEY=

# Resend — digest-completion email notification (research.md §10, FR-023)
RESEND_API_KEY=
# Optional: verified Resend sender identity. Falls back to a placeholder
# default in src/notify/email.py if unset (must be a domain verified with
# Resend before real sends will succeed).
RESEND_FROM_EMAIL=

# Official X API v2 (via tweepy) — OAuth 1.0a user-context credentials for posting
# and for the live bio "automated"-label check (FR-013, FR-014, FR-022).
#
# Each User posts as their own X account (User.x_account_handle), so these are
# namespaced per user rather than shared (FR-015, tasks.md T067): suffix each
# var with that user's x_account_handle, upper-cased with any non-alphanumeric
# characters collapsed to `_` (see src/config.py's load_x_credentials_for_user).
# For a user with x_account_handle "pilot":
X_API_KEY__PILOT=
X_API_SECRET__PILOT=
X_ACCESS_TOKEN__PILOT=
X_ACCESS_TOKEN_SECRET__PILOT=
# A second user, e.g. x_account_handle "pilot_two", gets its own fully
# independent set: X_API_KEY__PILOT_TWO, X_API_SECRET__PILOT_TWO, etc. There is
# no shared/unnamespaced fallback — a user with no namespaced vars configured
# fails fast rather than silently posting through another user's account.
