# Copy this file to .env and fill in real values locally.
# .env is already gitignored — never commit real credentials (Constitution V, FR-021).

# TwitterAPI.io — third-party X data read provider (research.md §6)
TWITTERAPI_IO_KEY=

# Anthropic Claude API — Summarize / Draft Post stages only (research.md §3)
ANTHROPIC_API_KEY=

# Resend — digest-completion email notification (research.md §10, FR-023)
RESEND_API_KEY=
# Optional: verified Resend sender identity. Falls back to a placeholder
# default in src/notify/email.py if unset (must be a domain verified with
# Resend before real sends will succeed).
RESEND_FROM_EMAIL=

# Official X API v2 (via tweepy) — OAuth 1.0a user-context credentials for posting
# and for the live bio "automated"-label check (FR-013, FR-014, FR-022).
#
# Each User posts as their own X account (User.x_account_handle), so these are
# namespaced per user rather than shared (FR-015, tasks.md T067): suffix each
# var with that user's x_account_handle, upper-cased with any non-alphanumeric
# characters collapsed to `_` (see src/config.py's load_x_credentials_for_user).
# For a user with x_account_handle "pilot":
X_API_KEY__PILOT=
X_API_SECRET__PILOT=
X_ACCESS_TOKEN__PILOT=
X_ACCESS_TOKEN_SECRET__PILOT=
# A second user, e.g. x_account_handle "pilot_two", gets its own fully
# independent set: X_API_KEY__PILOT_TWO, X_API_SECRET__PILOT_TWO, etc. There is
# no shared/unnamespaced fallback — a user with no namespaced vars configured
# fails fast rather than silently posting through another user's account.
