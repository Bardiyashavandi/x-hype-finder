# Copy this file to .env and fill in real values locally.
# .env is already gitignored — never commit real credentials (Constitution V, FR-021).

# TwitterAPI.io — third-party X data read provider (research.md §6)
TWITTERAPI_IO_KEY=

# Anthropic Claude API — Summarize / Draft Post stages only (research.md §3)
ANTHROPIC_API_KEY=

# Resend — digest-completion email notification (research.md §10, FR-023)
RESEND_API_KEY=
# Optional: verified Resend sender identity. Falls back to a placeholder
# default in src/notify/email.py if unset (must be a domain verified with
# Resend before real sends will succeed).
RESEND_FROM_EMAIL=

# Official X API v2 (via tweepy) — OAuth 1.0a user-context credentials for posting
# and for the live bio "automated"-label check (FR-013, FR-014, FR-022).
# Per-user namespacing/isolation (FR-015) is implemented in a later phase (see tasks.md T067);
# for local single-user development, these four map to one X account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
